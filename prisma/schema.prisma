// Avencao CRM — schéma PostgreSQL (Prisma 7)
//
// Conventions
// - Montants : NUMERIC(18,2) + devise explicite. Jamais de float.
// - Taux de change : NUMERIC(20,10), exprimés en « unités de devise pour 1 EUR »
//   (ex. 18000 IDR pour 1 EUR). Montant EUR = montant / fxUnitsPerEur.
// - Instants : timestamptz (UTC). Échéances : DATE locale, interprétée dans le
//   fuseau de l'agence (AgencySettings.timezone).
// - Chaque montant a une source unique (voir docs/definitions-financieres.md).
// - Les mouvements validés ne sont jamais supprimés : ils sont annulés (VOIDED)
//   avec motif et auteur, et l'opération est tracée dans AuditEvent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

