{
  "name": "avencao-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "worker": "tsx --conditions=react-server worker/index.ts",
    "import:legacy": "tsx --conditions=react-server scripts/import-legacy/index.ts",
    "postinstall": "prisma generate",
    "check:env": "tsx scripts/check-env.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@date-fns/tz": "1.5.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "6.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-table": "9.3.1",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "lucide-react": "1.61.0",
    "mysql2": "3.24.6",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
