# ─── Avencao CRM — variables d'environnement (aucune valeur secrète ici) ───

# PostgreSQL (base cible unique)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/avencao_dev?schema=public"
# Base dédiée aux tests d'intégration (vidée par les tests)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/avencao_test?schema=public"
# Migrations uniquement (Supabase : pooler en mode session, port 5432). Vide = DATABASE_URL.
DIRECT_URL=""
# Facultatif : certificat racine PEM du fournisseur pour vérifier le TLS (sinon chiffré sans vérification si sslmode=require)
DATABASE_CA_CERT=""
# Facultatif : connexions par instance (3 conseillé sur Vercel)
DATABASE_POOL_MAX=""

# Authentification (Better Auth). Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL publique (liens d'invitation). Vide sur Vercel = domaine de production du projet.
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# Facultatif : autres origines autorisées à se connecter, séparées par des virgules
EXTRA_TRUSTED_ORIGINS=""

# Connexion
# Adresses de l'équipe interne (liste déroulante, code + lien par email, administrateurs au 1er accès)
LOGIN_EMAILS=""
# "false" désactive la connexion par mot de passe (comptes créés par un administrateur)
PASSWORD_LOGIN=""
# Administrateurs principaux : accès complet permanent, non modifiables par un autre administrateur
MASTER_ADMIN_EMAILS=""
# Développement : le code s'affiche dans la console ; "true" pour envoyer réellement l'email
SEND_LOGIN_EMAILS_IN_DEV=""

# Stockage des pièces jointes : "local" (développement) ou "s3" (compatible S3)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Cloudflare R2 : S3_REGION="auto", S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", S3_FORCE_PATH_STYLE="true"
S3_FORCE_PATH_STYLE="false"

# Email (facultatif). Sans canal configuré, les liens d'invitation sont affichés à l'admin, rien n'est « envoyé ».
# Option 1 — Resend (recommandé) : clé API + expéditeur sur un domaine vérifié dans Resend.
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_REPLY_TO=""
# Option 2 — SMTP générique (utilisé seulement si RESEND_API_KEY est vide ; EMAIL_FROM ou SMTP_FROM requis).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Supabase (facultatif, non utilisé par l'application : la base passe par DATABASE_URL).
# Pour héberger la base sur Supabase, renseigner DATABASE_URL avec la chaîne de connexion Postgres du projet.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Déclencheur cron authentifié (POST /api/cron/<job>, en-tête Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
# "true" : le cron exécute le job directement (défaut sur Vercel) ; "false" : file pg-boss + worker
JOBS_INLINE=""

# Seeds de démonstration (jamais en production sans ALLOW_DEMO_SEED=1)
SEED_ADMIN_EMAIL="admin@avencao.test"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
ALLOW_DEMO_SEED=""

# Import de l'historique Rails (lecture seule)
LEGACY_MYSQL_URL=""
LEGACY_STORAGE_DIR=""
# Obligatoire avec --apply quand NODE_ENV=production, après validation de la simulation
ALLOW_LEGACY_IMPORT=""

# Tests de bout en bout (Playwright) : mot de passe des comptes de démo (défaut : SEED_ADMIN_PASSWORD)
E2E_PASSWORD=""
E2E_BASE_URL="http://localhost:3000"

# Sauvegardes : dossier des binaires PostgreSQL si pg_dump du PATH est plus ancien que le serveur
PG_BIN=""
